%% Beamer theme colors
% Choose default colors
\colorlet{mitprimary}{mitred}
\colorlet{mitsecondary}{mitbrightred}

% Beamer color theme
\setbeamercolor{alerted text}{fg=mitprimary}
\setbeamercolor*{palette primary}{fg=mitprimary,bg=mitgray}
\setbeamercolor*{palette secondary}{bg=white,fg=mitgray}
\setbeamercolor*{palette tertiary}{bg=white,fg=darkgray}
\setbeamercolor*{palette quaternary}{bg=mitprimary,fg=white}
\setbeamercolor*{structure}{fg=mitprimary,bg=white}
\setbeamercolor*{frametitle}{bg=white,fg=mitprimary}
\setbeamercolor*{framesubtitle}{fg=mitgray}
\setbeamercolor*{section in toc}{fg=mitprimary,bg=white}
\setbeamercolor*{titlelike}{fg=mitprimary,bg=white}
\setbeamercolor*{example text}{fg=mitteal}

% Block colors
\setbeamercolor*{block title}{fg=mitprimary,bg=white}
\setbeamercolor*{block body}{fg=black,bg=white}
\setbeamercolor*{block title alerted}{fg=white,bg=mitprimary}
\setbeamercolor*{block body alerted}{fg=black,bg=mitgray!12!white}
\setbeamercolor*{block title example}{fg=white,bg=mitteal}
\setbeamercolor*{block body example}{fg=black,bg=mitteal!25}

% Bibliography colors
\setbeamercolor{bibliography entry author}{fg=mitprimary}
\setbeamercolor{bibliography entry title}{fg=black}
\setbeamercolor{bibliography entry location}{fg=black}
\setbeamercolor{bibliography entry note}{fg=black}