\ProcessOptionsBeamer
\mode<presentation>

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Declare RRgroup3 theme options
% 1. Show Tim the Beaver on standout frames?
\newif\ifmy@showtim\DeclareOption{tim}{\my@showtimtrue}
% 2. Set up biblatex with biber backend? (no if you want to manually set up bibliography)
\newif\ifmy@setbiber\DeclareOption{biber}{\my@setbibertrue}
% 3. Set up hyperref options? (no if you want to manually set up hyperref)
\newif\ifmy@sethyperref\DeclareOption{hyperref}{\my@sethyperreftrue}
% 4. Show slide progress bars on section title frames?
\newif\ifmy@showprogress\DeclareOption{progressbar}{\my@showprogresstrue}
% 5. Disable red bars in the footer?
\newif\ifmy@nofooterbars\DeclareOption{nofooterbars}{\my@nofooterbarstrue}
% 6. Academic unit option (meche, aeroastro, ccse, chefsi, isn)
\newif\ifmy@unitismeche\DeclareOption{meche}{\my@unitismechetrue}
\newif\ifmy@unitisaeroastro\DeclareOption{aeroastro}{\my@unitisaeroastrotrue}
\newif\ifmy@unitisccse\DeclareOption{ccse}{\my@unitisccsetrue}
\newif\ifmy@unitischefsi\DeclareOption{chefsi}{\my@unitischefsitrue}
\newif\ifmy@unitisisn\DeclareOption{isn}{\my@unitisisntrue}
% 7. A website URL can be specified with \website{url} in the preamble
\newcommand{\website}[1]{\providecommand{\setwebsite}{#1}}

\ProcessOptions\relax%

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Set default styles (can be overridden by user)
% Beamer default themes
\useoutertheme[footline=authorinstitutetitle]{miniframes}
\usecolortheme{RRgroup}
\useinnertheme{circles}
\setbeamertemplate{headline}{\vspace*{2.5em}} % Set top margin
\setbeamertemplate{navigation symbols}{}      % Remove nav buttons
\setbeamertemplate{frametitle continuation}[from second][\insertcontinuationcountroman]

% Title page colors
\setbeamercolor{title}{fg=white}
\setbeamercolor{subtitle}{fg=mitsecondary}
\setbeamercolor{author}{fg=white}
\setbeamercolor{date}{fg=white}
\setbeamercolor{institute}{fg=white}

%% Academic unit-specific options
% - Mechanical Engineering
\ifmy@unitismeche%
    \providecommand{\rightlogo}{meche-white.png}
    \colorlet{mitprimary}{black}%
    \colorlet{mitsecondary}{mitgray}%
\fi%
% - AeroAstro
\ifmy@unitisaeroastro%
    \providecommand{\rightlogo}{aeroastro-white.png}%
    \colorlet{mitprimary}{aeroastroblue}%
    \colorlet{mitsecondary}{mitgray}%
\fi%
% - Center for Computational Science & Engineering
\ifmy@unitisccse%
    \providecommand{\rightlogo}{ccse-white.png}%
    \colorlet{mitprimary}{mitdarkblue}%
    \colorlet{mitsecondary}{mitteal}%
\fi%
% - CHEFSI
\ifmy@unitischefsi%
    \providecommand{\rightlogo}{chefsi-white.png}%
\fi%
% - Institute for Soldier Nanotechnologies
\ifmy@unitisisn%
    \providecommand{\rightlogo}{isn-white.png}%
    \colorlet{mitprimary}{mitblue}%
    \colorlet{mitsecondary}{black}%
\fi%

% Logo paths
\providecommand{\leftlogo}{mit-long-lockup-white.png}
\providecommand{\footerlogo}{mit-lockup-red.png}
\providecommand{\footerlogolong}{mit-long-lockup-red.png}
\providecommand{\standoutlogo}{tim.png}

% Default font sizes and weights
\setbeamerfont{normal text}{size=\small}
\setbeamerfont{title}{size=\Huge,series=\bfseries}
\setbeamerfont{subtitle}{size=\Huge,series=\bfseries}
\setbeamerfont{frametitle}{size=\LARGE,series=\bfseries}
\setbeamerfont{framesubtitle}{size=\large,series=\bfseries}
\setbeamerfont{author}{size=\small,series=\bfseries}
\setbeamerfont{institute}{size=\small,series=\mdseries}
\setbeamerfont{date}{size=\small}
\setbeamerfont{section in toc}{series=\bfseries}
\setbeamerfont{block title}{size=\normalsize,series=\bfseries}
\setbeamerfont{block body}{size=\normalsize}

% Font sizes of bibliography
\newcommand{\bibfontsize}{\small}
\setbeamertemplate{bibliography item}{}
\setbeamerfont{bibliography item}{size=\bibfontsize}
\setbeamerfont{bibliography entry author}{size=\bibfontsize,series=\bfseries}
\setbeamerfont{bibliography entry title}{size=\bibfontsize,series=\mdseries}
\setbeamerfont{bibliography entry location}{size=\bibfontsize}
\setbeamerfont{bibliography entry note}{size=\bibfontsize}

% Shrink default left-right margins
\setbeamersize{text margin left=5mm,text margin right=5mm}

